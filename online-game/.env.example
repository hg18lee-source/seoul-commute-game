# Pooled PostgreSQL URI used only on the game server
DATABASE_URL=
# Optional direct PostgreSQL URI for migration and administrator initialization
DIRECT_DATABASE_URL=
# At least 32 bytes of independent random secret material for Argon2id and CSRF
PASSWORD_PEPPER=
# Vercel cron authentication secret
CRON_SECRET=
# Optional audit and progress retention in days
AUDIT_RETENTION_DAYS=30
# Seoul Open Data subway station master key
SEOUL_OPENAPI_KEY=
# Data portal Seoul bus route information service key
DATA_GO_KR_SERVICE_KEY=
# Optional localhost dev port
PORT=8010
# Set to 1 only when testing via HTTPS. Vercel always sets Secure.
COOKIE_SECURE=

# Separate disposable PostgreSQL database for integration tests
TEST_DATABASE_URL=
